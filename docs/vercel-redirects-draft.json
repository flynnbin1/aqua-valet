    { "source": "/product/valet-1/", "destination": "/packages/full-valet/", "permanent": true },
    { "source": "/product/valet-2/", "destination": "/packages/full-valet/", "permanent": true },
    { "source": "/product/valet-3/", "destination": "/packages/full-valet/", "permanent": true },
    { "source": "/product/valet-4/", "destination": "/packages/full-valet/", "permanent": true },
    { "source": "/product/valet-5/", "destination": "/packages/full-valet/", "permanent": true },
    { "source": "/product/valet-6/", "destination": "/services/pickup-mobile-valeting/", "permanent": true },
    { "source": "/product/exterior-wash/", "destination": "/services/car-wash/", "permanent": true },
